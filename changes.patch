+    private func updateAmbientGradient(animated: Bool) {
+        let (upper, lower) = self.ambientArtworkColors ?? (
+            UIColor(red: 0.35, green: 0.40, blue: 0.46, alpha: 1.0),
+            UIColor(red: 0.38, green: 0.43, blue: 0.48, alpha: 1.0)
+        )
+        let isDark = self.presentationData.theme.overallDarkAppearance
+        func posterHue(_ color: UIColor) -> (CGFloat, CGFloat) {
+            var hue: CGFloat = 0.0
+            var saturation: CGFloat = 0.0
+            var brightness: CGFloat = 0.0
+            var alpha: CGFloat = 0.0
+            color.getHue(&hue, saturation: &saturation, brightness: &brightness, alpha: &alpha)
+            // A mostly black or grey cover still gets a cool, readable ambient tint.
+            return (saturation < 0.08 ? 0.62 : hue, max(0.78, saturation))
+        }
+        let top = posterHue(upper)
+        let bottom = posterHue(lower)
+        func stop(hue: CGFloat, saturation: CGFloat, brightness: CGFloat) -> CGColor {
+            return UIColor(hue: hue, saturation: saturation, brightness: brightness, alpha: 0.96).cgColor
+        }
+        let colors: [CGColor] = isDark ? [
+            stop(hue: top.0, saturation: top.1, brightness: 0.24),
+            stop(hue: bottom.0, saturation: bottom.1 * 0.92, brightness: 0.42),
+            stop(hue: bottom.0, saturation: bottom.1 * 0.72, brightness: 0.29)
+        ] : [
+            stop(hue: top.0, saturation: top.1, brightness: 0.36),
+            stop(hue: bottom.0, saturation: bottom.1 * 0.92, brightness: 0.72),
+            stop(hue: bottom.0, saturation: 0.38, brightness: 0.96)
+        ]
+
+        let previousColors = self.ambientGradientLayer.presentation()?.colors ?? self.ambientGradientLayer.colors
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.ambientGradientLayer.colors = colors
+        CATransaction.commit()
+        if animated, let previousColors {
+            let animation = CABasicAnimation(keyPath: "colors")
+            animation.fromValue = previousColors
+            animation.toValue = colors
+            animation.duration = 0.5
+            animation.timingFunction = CAMediaTimingFunction(name: .easeInEaseOut)
+            self.ambientGradientLayer.add(animation, forKey: "ambientColors")
+        }
+    }
+
+    private func updatePosterTilt(isPlaying: Bool) {
+        let shouldTilt = isPlaying && !self.isPosterFlightInProgress && self.currentAlbumArt != nil && self.albumArtNode.view.superview != nil
+        guard shouldTilt != self.isPosterTiltActive else {
+            return
+        }
+        self.isPosterTiltActive = shouldTilt
+        self.posterMotionLink?.invalidate()
+        self.posterMotionLink = nil
+        self.posterMotionTarget = nil
+
+        guard shouldTilt else {
+            self.albumArtNode.layer.transform = CATransform3DIdentity
+            return
+        }
+
+        let target = AudioPosterMotionTarget(node: self)
+        let link = CADisplayLink(target: target, selector: #selector(AudioPosterMotionTarget.tick(_:)))
+        link.preferredFramesPerSecond = 30
+        link.add(to: .main, forMode: .common)
+        self.posterMotionTarget = target
+        self.posterMotionLink = link
+    }
+
+    fileprivate func updatePosterMotionFrame(timestamp: CFTimeInterval) {
+        guard self.isPosterTiltActive else {
+            return
+        }
+        let orbitPhase = timestamp * 2.0 * .pi / 2.0
+        let tiltPhase = timestamp * 2.0 * .pi / 2.0
+        let angle = sin(tiltPhase) * 0.5 * .pi / 180.0
+        let pulseInPoints = 0.45 + self.posterAudioLevel * 0.55
+        let scale = 1.0 + sin(timestamp * 2.0 * .pi / 0.5) * pulseInPoints / max(self.albumArtNode.bounds.width, 1.0)
+        var transform = CATransform3DIdentity
+        transform.m34 = -1.0 / (500.0 * 0.62)
+        transform = CATransform3DRotate(transform, angle, cos(orbitPhase), sin(orbitPhase), 0.0)
+        transform = CATransform3DScale(transform, scale, scale, 1.0)
+        CATransaction.begin()
+        CATransaction.setDisableActions(true)
+        self.albumArtNode.layer.transform = transform
+        CATransaction.commit()
+    }
+
