+    @objc private func largeAlbumArtPan(_ recognizer: UIPanGestureRecognizer) {
+        guard recognizer.state == .ended, self.currentAlbumArt != nil else {
+            return
+        }
+
+        let translation = recognizer.translation(in: self.albumArtNode.view)
+        let velocity = recognizer.velocity(in: self.albumArtNode.view)
+        let horizontalDistance = abs(translation.x)
+        let horizontalVelocity = abs(velocity.x)
+        if translation.y > 0.0,
+           translation.y > horizontalDistance * 1.2,
+           (translation.y > 48.0 || (translation.y > 24.0 && velocity.y > 500.0)) {
+            self.collapseAlbumArt()
+            return
+        }
+        guard horizontalDistance > 48.0 || (horizontalDistance > 24.0 && horizontalVelocity > 500.0),
+              horizontalDistance > abs(translation.y) * 1.2 else {
+            return
+        }
+
+        self.controlsNode.control?(translation.x < 0.0 ? .next : .previous)
+    }
             
