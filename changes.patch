+        self.currentAlbumArt = nil
+        self.updatePosterTilt(isPlaying: false)
+        self.controlsNode.usesAmbientBackdrop = false
+        self.containerLayoutUpdated(layout, transition: .animated(duration: 0.3, curve: .easeInOut))
+    }
