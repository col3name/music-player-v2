+private func albumArtAmbientColors(_ image: UIImage) -> (UIColor, UIColor)? {
+    guard let source = image.cgImage else {
+        return nil
+    }
+    let side = 24
+    var pixels = [UInt8](repeating: 0, count: side * side * 4)
+    return pixels.withUnsafeMutableBytes { bytes -> (UIColor, UIColor)? in
+        guard let data = bytes.baseAddress,
+              let context = CGContext(data: data, width: side, height: side, bitsPerComponent: 8, bytesPerRow: side * 4,
+                                      space: CGColorSpaceCreateDeviceRGB(),
+                                      bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue) else {
+            return nil
+        }
+        context.interpolationQuality = .low
+        context.draw(source, in: CGRect(x: 0.0, y: 0.0, width: CGFloat(side), height: CGFloat(side)))
+        let pixelData = bytes.bindMemory(to: UInt8.self)
+
+        var colored = [(Double, Double, Double, Double)](repeating: (0.0, 0.0, 0.0, 0.0), count: 2)
+        var neutral = [(Double, Double, Double, Double)](repeating: (0.0, 0.0, 0.0, 0.0), count: 2)
+        for index in 0 ..< side * side {
+            let offset = index * 4
+            if pixelData[offset + 3] < 128 {
+                continue
+            }
+            let red = Double(pixelData[offset]) / 255.0
+            let green = Double(pixelData[offset + 1]) / 255.0
+            let blue = Double(pixelData[offset + 2]) / 255.0
+            let maximum = max(red, max(green, blue))
+            let minimum = min(red, min(green, blue))
+            if maximum < 0.07 || minimum > 0.96 {
+                continue // Ignore letterbox black and the white placeholder.
+            }
+            let half = index / side < side / 2 ? 0 : 1
+            var plain = neutral[half]
+            plain.0 += red
+            plain.1 += green
+            plain.2 += blue
+            plain.3 += 1.0
+            neutral[half] = plain
+
+            let saturation = maximum - minimum
+            if saturation > 0.09 {
+                let weight = 0.2 + saturation * 2.0
+                var vivid = colored[half]
+                vivid.0 += red * weight
+                vivid.1 += green * weight
+                vivid.2 += blue * weight
+                vivid.3 += weight
+                colored[half] = vivid
+            }
+        }
+
+        func color(for half: Int) -> UIColor? {
+            let sample = colored[half].3 > 1.0 ? colored[half] : neutral[half]
+            guard sample.3 > 0.0 else {
+                return nil
+            }
+            return UIColor(red: CGFloat(sample.0 / sample.3), green: CGFloat(sample.1 / sample.3), blue: CGFloat(sample.2 / sample.3), alpha: 1.0)
+        }
+        guard let upper = color(for: 0) ?? color(for: 1),
+              let lower = color(for: 1) ?? color(for: 0) else {
+            return nil
+        }
+        return (upper, lower)
+    }
+}
